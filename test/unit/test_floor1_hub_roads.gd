extends GutTest

## JGT-134: the Floor 1 city centre holds a circular hub (22% of the city
## diameter), a diamond tower on the exact city centre and four straight 8 tile
## roads from the hub edge to the city wall. Generated by
## tools/gen_floor1_layout.py.

const ZONES_DIR := "res://data/zones/floor1"
const WORLD_PATH := ZONES_DIR + "/world.json"
const START_CHUNK := "floor1_x2_y1"
const CHUNK := 32
const MAP_W := 288
const MAP_H := 128

const CITY_CENTER := Vector2(96.0, 64.0)
const CITY_RADIUS := 61.0
const CITY_FLOOR_RADIUS := 58.0
const HUB_RADIUS := CITY_RADIUS * 0.22
const ROAD_WIDTH := 8
const TOWER_RADIUS := 3.0
const ENTRY_TILE := Vector2i(93, 58)

var world: WorldMap = null
var zones: Dictionary = {}  # chunk id -> Zone


func before_all() -> void:
	world = WorldMap.load_file(WORLD_PATH)
	for chunk_id: String in world.chunk_ids():
		var stem := world.zone_stem(chunk_id)
		zones[chunk_id] = Zone.load_files(ZONES_DIR.path_join(stem + ".map"), ZONES_DIR.path_join(stem + ".json"))


func _zone_at(world_tile: Vector2i) -> Zone:
	return zones.get(world.chunk_id_at_tile(world_tile), null)


func _local(world_tile: Vector2i) -> Vector2i:
	return Vector2i(posmod(world_tile.x, CHUNK), posmod(world_tile.y, CHUNK))


func _type(world_tile: Vector2i) -> String:
	var zone := _zone_at(world_tile)
	return zone.tile_type(_local(world_tile)) if zone != null else ""


func _decor(world_tile: Vector2i) -> String:
	var zone := _zone_at(world_tile)
	return zone.decor_at(_local(world_tile)) if zone != null else ""


func _walkable(world_tile: Vector2i) -> bool:
	var zone := _zone_at(world_tile)
	return zone != null and zone.is_walkable(_local(world_tile))


func _safe(world_tile: Vector2i) -> bool:
	var zone := _zone_at(world_tile)
	return zone != null and zone.is_safe(_local(world_tile))


func _city_dist(world_tile: Vector2i) -> float:
	return (Vector2(world_tile) + Vector2(0.5, 0.5) - CITY_CENTER).length()


func _tower_dist(world_tile: Vector2i) -> float:
	return absf(world_tile.x + 0.5 - CITY_CENTER.x) + absf(world_tile.y + 0.5 - CITY_CENTER.y)


func _start_entry() -> Vector2i:
	var zone: Zone = zones[START_CHUNK]
	return world.chunk_to_world(START_CHUNK, zone.entry)


func test_hub_is_a_circle_on_the_city_centre() -> void:
	var min_t := Vector2i(MAP_W, MAP_H)
	var max_t := Vector2i(-1, -1)
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if _type(t) != "hub_floor":
				continue
			min_t = Vector2i(mini(min_t.x, x), mini(min_t.y, y))
			max_t = Vector2i(maxi(max_t.x, x), maxi(max_t.y, y))
	assert_gt(max_t.x, min_t.x, "the floor has a hub")

	var size := Vector2(max_t - min_t + Vector2i.ONE)
	assert_almost_eq(size.x, 2.0 * HUB_RADIUS, 1.0, "hub diameter is 22% of the city diameter")
	assert_almost_eq(size.y, 2.0 * HUB_RADIUS, 1.0, "hub diameter is 22% of the city diameter")
	assert_almost_eq(size.x, size.y, 1.0, "the hub is a circle, not an ellipse")
	var center := (Vector2(min_t) + Vector2(max_t + Vector2i.ONE)) * 0.5
	assert_almost_eq(center.x, CITY_CENTER.x, 0.5, "hub centred on x=96")
	assert_almost_eq(center.y, CITY_CENTER.y, 0.5, "hub centred on y=64")

	# Every tile inside the hub radius belongs to the plaza (props and tower included).
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if _city_dist(t) <= HUB_RADIUS - 0.05:
				assert_eq(_type(t), "hub_floor", "hub tile %s" % str(t))


func test_four_roads_are_eight_wide_and_walkable_to_the_wall() -> void:
	var ew_rows := {}
	var ns_cols := {}
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if _type(t) != "road":
				continue
			assert_true(_walkable(t), "road tile %s is walkable" % str(t))
			assert_true(_safe(t), "road tile %s is safe" % str(t))
			if absf(t.y + 0.5 - CITY_CENTER.y) < ROAD_WIDTH / 2.0:
				ew_rows[t.y] = true
			else:
				ns_cols[t.x] = true

	assert_eq(ew_rows.size(), ROAD_WIDTH, "the east/west roads are 8 tiles wide")
	assert_eq(ns_cols.size(), ROAD_WIDTH, "the north/south roads are 8 tiles wide")

	# East/west roads are unbroken from the hub edge through the gates to the wall.
	for row: int in ew_rows.keys():
		for x in range(MAP_W):
			var dx := absf(x + 0.5 - CITY_CENTER.x)
			if dx <= HUB_RADIUS or dx > CITY_RADIUS:
				continue
			var t := Vector2i(x, row)
			assert_eq(_type(t), "road", "%s is on the east/west road" % str(t))
			assert_true(_walkable(t), "road tile %s is walkable" % str(t))

	# North/south roads are unbroken from the hub edge to the inner wall edge.
	for col: int in ns_cols.keys():
		for y in range(MAP_H):
			var dy := absf(y + 0.5 - CITY_CENTER.y)
			if dy <= HUB_RADIUS or dy > CITY_FLOOR_RADIUS:
				continue
			var t := Vector2i(col, y)
			assert_eq(_type(t), "road", "%s is on the north/south road" % str(t))
			assert_true(_walkable(t), "road tile %s is walkable" % str(t))


func test_tower_is_a_diamond_on_the_exact_city_centre() -> void:
	var cells := {}
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if _decor(t) == "tower":
				cells[t] = true
	assert_gt(cells.size(), 0, "the hub has a tower")

	for t: Vector2i in cells.keys():
		assert_false(_walkable(t), "tower tile %s is not walkable" % str(t))
		assert_lte(_tower_dist(t), TOWER_RADIUS + 0.01, "tower tile %s is inside the diamond" % str(t))
		# Reflection across the exact centre (96, 64) maps tile x -> 191 - x, y -> 127 - y.
		var mirror := Vector2i(191 - t.x, 127 - t.y)
		assert_true(cells.has(mirror), "tower tile %s mirrors to %s" % [str(t), str(mirror)])

	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if _tower_dist(t) <= TOWER_RADIUS:
				assert_true(cells.has(t), "tower fills diamond tile %s" % str(t))


func test_entry_stays_walkable_on_the_hub_and_off_the_tower() -> void:
	var entry := _start_entry()
	assert_eq(entry, ENTRY_TILE, "the floor entry stays at (93, 58)")
	assert_true(_walkable(entry), "entry is walkable")
	assert_true(_safe(entry), "entry is safe")
	assert_lte(_city_dist(entry), HUB_RADIUS, "entry stands on the hub")
	assert_ne(_decor(entry), "tower", "entry is not on the tower")
	assert_false(_tower_dist(entry) <= TOWER_RADIUS, "entry is clear of the tower footprint")


func test_no_torch_or_house_touches_a_road() -> void:
	var house_cells: Array[Vector2i] = []
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			var decor := _decor(t)
			if decor == "torch":
				assert_ne(_type(t), "road", "torch at %s stays off the roads" % str(t))
			elif decor.begins_with("house_"):
				house_cells.append(t)
				assert_ne(_type(t), "road", "house part at %s stays off the roads" % str(t))
	assert_gt(house_cells.size(), 0, "the city keeps its houses")

	# Houses keep a one tile margin clear of the hub and its roads.
	for t: Vector2i in house_cells:
		for dy in range(-1, 2):
			for dx in range(-1, 2):
				var around := t + Vector2i(dx, dy)
				assert_ne(_type(around), "road", "house at %s keeps road tile %s clear" % [str(t), str(around)])
				assert_gt(_city_dist(around), HUB_RADIUS, "house at %s keeps the hub clear" % str(t))
