extends GutTest

## JGT-121/JGT-132/JGT-133: Floor 1 laid out as a 9x4 chunk grid (288x128
## tiles): a safe city circle pinned at (96, 64), ringed by a solid wall with a
## west and an east gate, plains around it (including the three east plains
## columns) and a wall around the whole map.
## Generated by tools/gen_floor1_layout.py.

const ZONES_DIR := "res://data/zones/floor1"
const WORLD_PATH := ZONES_DIR + "/world.json"
const ENEMIES_PATH := "res://data/enemies.json"
const START_CHUNK := "floor1_x2_y1"
const MERCHANT_ID := "floor1_city_merchant"
const GRID_W := 9
const GRID_H := 4
const CHUNK := 32
const MAP_W := GRID_W * CHUNK
const MAP_H := GRID_H * CHUNK
## City circle centred at (96, 64): outer wall radius 61 tiles (diameter ~122),
## a 3 tile thick wall ring (58 < distance <= 61) with west/east gate openings
## on rows 60..67. The east plains columns must not move it.
const CITY_CENTER := Vector2(96.0, 64.0)
const CITY_RADIUS := 61.0
const CITY_FLOOR_RADIUS := 58.0
const CITY_DIAMETER := 122.0

var world: WorldMap = null
var zones: Dictionary = {}  # chunk id -> Zone


func before_all() -> void:
	world = WorldMap.load_file(WORLD_PATH)
	for chunk_id: String in world.chunk_ids():
		var stem := world.zone_stem(chunk_id)
		zones[chunk_id] = Zone.load_files(ZONES_DIR.path_join(stem + ".map"), ZONES_DIR.path_join(stem + ".json"))


func _zone_at(world_tile: Vector2i) -> Zone:
	var chunk_id := world.chunk_id_at_tile(world_tile)
	return zones.get(chunk_id, null)


func _local(world_tile: Vector2i) -> Vector2i:
	return Vector2i(posmod(world_tile.x, CHUNK), posmod(world_tile.y, CHUNK))


func _walkable(world_tile: Vector2i) -> bool:
	if world_tile.x < 0 or world_tile.y < 0 or world_tile.x >= MAP_W or world_tile.y >= MAP_H:
		return false
	var zone := _zone_at(world_tile)
	return zone != null and zone.is_walkable(_local(world_tile))


func _safe(world_tile: Vector2i) -> bool:
	var zone := _zone_at(world_tile)
	return zone != null and zone.is_safe(_local(world_tile))


func _city_dist(world_tile: Vector2i) -> float:
	return (Vector2(world_tile) + Vector2(0.5, 0.5) - CITY_CENTER).length()


func _in_circle(world_tile: Vector2i) -> bool:
	return _city_dist(world_tile) <= CITY_RADIUS


func _on_city_wall(world_tile: Vector2i) -> bool:
	var d := _city_dist(world_tile)
	return d > CITY_FLOOR_RADIUS and d <= CITY_RADIUS


func _tile(value: Variant) -> Vector2i:
	var arr: Array = value
	return Vector2i(int(arr[0]), int(arr[1]))


func _start_entry() -> Vector2i:
	var zone: Zone = zones[START_CHUNK]
	return world.chunk_to_world(START_CHUNK, zone.entry)


func test_world_is_a_9x4_grid_of_32_tile_chunks() -> void:
	assert_true(world.is_valid(), "world.json errors: %s" % str(world.errors))
	assert_eq(world.chunk_size, Vector2i(CHUNK, CHUNK))
	assert_eq(world.chunk_ids().size(), GRID_W * GRID_H, "36 chunks")
	for y in range(GRID_H):
		for x in range(GRID_W):
			assert_false(world.chunk_at_cell(Vector2i(x, y)).is_empty(), "grid cell [%d, %d] must hold a chunk" % [x, y])
	for chunk_id: String in world.chunk_ids():
		var cell := world.grid_cell(chunk_id)
		assert_true(cell.x >= 0 and cell.x < GRID_W and cell.y >= 0 and cell.y < GRID_H, "%s grid %s inside 9x4" % [chunk_id, str(cell)])


func test_world_size_is_288_by_128() -> void:
	var chunked := ChunkedWorld.load_file(WORLD_PATH, ZONES_DIR)
	assert_true(chunked.is_valid(), "chunked world errors: %s" % str(chunked.errors))
	assert_eq(chunked.world_width(), MAP_W)
	assert_eq(chunked.world_height(), MAP_H)


func test_every_chunk_zone_loads_and_fills_its_chunk() -> void:
	for chunk_id: String in world.chunk_ids():
		var zone: Zone = zones[chunk_id]
		assert_true(zone.is_valid(), "%s errors: %s" % [chunk_id, str(zone.errors)])
		assert_eq(Vector2i(zone.width, zone.height), world.chunk_size, "%s must fill one chunk" % chunk_id)
		assert_eq(zone.exits.size(), 0, "%s has no zone exits" % chunk_id)


func test_old_strip_chunks_and_dungeon_door_are_gone() -> void:
	for old_id: String in ["floor1_town", "floor1_plains", "floor1_plains_east", "floor1_center"]:
		assert_false(world.has_chunk(old_id), "%s must be removed" % old_id)
	for chunk_id: String in world.chunk_ids():
		for transition: Dictionary in world.transitions_of(chunk_id):
			# The boss gate (JGT-122) is the only door; see test_floor1_boss_gate.gd.
			assert_true(str(transition["id"]).begins_with("boss_gate_"), "only the boss gate is a transition")


func test_no_dangling_transition_refs() -> void:
	for chunk_id: String in world.chunk_ids():
		for transition: Dictionary in world.transitions_of(chunk_id):
			var to_chunk := str(transition.get("to_chunk", ""))
			if to_chunk.is_empty():
				assert_eq(str(transition["kind"]), "door", "a transition without a chunk target is a zone door")
				continue  # zone door (boss gate): validated in test_floor1_boss_gate.gd
			assert_true(world.has_chunk(str(transition["from_chunk"])), "transition %s from chunk exists" % transition["id"])
			assert_true(world.has_chunk(to_chunk), "transition %s targets a known chunk" % transition["id"])
			assert_true(_walkable(world.chunk_to_world(chunk_id, transition["from_tile"])), "transition %s from tile walkable" % transition["id"])
			assert_true(_walkable(world.chunk_to_world(to_chunk, transition["to_tile"])), "transition %s to tile walkable" % transition["id"])


func test_all_adjacent_chunks_are_connected_by_open_edges() -> void:
	for y in range(GRID_H):
		for x in range(GRID_W):
			var origin := Vector2i(x * CHUNK, y * CHUNK)
			if x + 1 < GRID_W:
				var open := 0
				for i in range(CHUNK):
					var left := origin + Vector2i(CHUNK - 1, i)
					if _walkable(left) and _walkable(left + Vector2i.RIGHT):
						open += 1
				assert_gt(open, CHUNK / 2, "chunk [%d, %d] opens east to [%d, %d]" % [x, y, x + 1, y])
			if y + 1 < GRID_H:
				var open := 0
				for i in range(CHUNK):
					var top := origin + Vector2i(i, CHUNK - 1)
					if _walkable(top) and _walkable(top + Vector2i.DOWN):
						open += 1
				assert_gt(open, CHUNK / 2, "chunk [%d, %d] opens south to [%d, %d]" % [x, y, x, y + 1])


func test_every_walkable_tile_is_reachable_from_the_entry() -> void:
	var start := _start_entry()
	assert_true(_walkable(start), "entry must be walkable")
	var seen := {start: true}
	var queue: Array[Vector2i] = [start]
	var head := 0
	while head < queue.size():
		var t := queue[head]
		head += 1
		for step: Vector2i in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
			var n := t + step
			if not seen.has(n) and _walkable(n):
				seen[n] = true
				queue.append(n)
	var walkable := 0
	for y in range(MAP_H):
		for x in range(MAP_W):
			if _walkable(Vector2i(x, y)):
				walkable += 1
	assert_eq(seen.size(), walkable, "the whole floor is one connected area")
	var east_chunk := world.chunk_at_cell(Vector2i(GRID_W - 1, 1))
	var east_entry := world.chunk_to_world(east_chunk, zones[east_chunk].entry)
	assert_true(seen.has(east_entry), "the city start reaches the far east plains")


func test_outer_ring_is_wall_with_rounded_corners() -> void:
	for x in range(MAP_W):
		assert_false(_walkable(Vector2i(x, 0)), "top wall at x=%d" % x)
		# The boss gate (x 162..171) is the one opening in the bottom wall.
		var in_gate := x >= 162 and x <= 171
		assert_eq(_walkable(Vector2i(x, MAP_H - 1)), in_gate, "bottom wall at x=%d" % x)
	for y in range(MAP_H):
		assert_false(_walkable(Vector2i(0, y)), "left wall at y=%d" % y)
		assert_false(_walkable(Vector2i(MAP_W - 1, y)), "right wall at y=%d" % y)
	for corner: Vector2i in [Vector2i(1, 1), Vector2i(MAP_W - 2, 1), Vector2i(1, MAP_H - 2), Vector2i(MAP_W - 2, MAP_H - 2)]:
		assert_false(_walkable(corner), "corner %s is rounded off with wall" % str(corner))
	assert_true(_walkable(Vector2i(MAP_W / 2, 1)), "the wall is one tile thick along the edges")
	assert_true(_walkable(Vector2i(1, MAP_H / 2)), "the wall is one tile thick along the edges")
	for y in range(1, MAP_H - 1):
		for x in range(1, MAP_W - 1):
			var t := Vector2i(x, y)
			var zone := _zone_at(t)
			if zone.tile_type(_local(t)) == "wall":
				var near_edge := mini(mini(x, y), mini(MAP_W - 1 - x, MAP_H - 1 - y)) <= 8
				assert_true(near_edge or _on_city_wall(t), "inner wall tile %s only allowed in the rounded corners or the city ring" % str(t))


func test_city_circle_proportions() -> void:
	var min_t := Vector2i(MAP_W, MAP_H)
	var max_t := Vector2i(-1, -1)
	var count := 0
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if not _in_circle(t):
				continue
			min_t = Vector2i(mini(min_t.x, x), mini(min_t.y, y))
			max_t = Vector2i(maxi(max_t.x, x), maxi(max_t.y, y))
			count += 1
	assert_gt(count, 0, "the floor has a city")
	var size := Vector2(max_t - min_t + Vector2i.ONE)
	assert_almost_eq(size.x, CITY_DIAMETER, 2.0, "city diameter ~122 tiles")
	assert_almost_eq(size.y, CITY_DIAMETER, 2.0, "city diameter ~122 tiles")
	assert_almost_eq(size.x, size.y, 1.0, "the city is a perfect circle, not an ellipse")
	var center := (Vector2(min_t) + Vector2(max_t + Vector2i.ONE)) * 0.5
	assert_almost_eq(center.x, CITY_CENTER.x, 1.0, "city centred at x=96")
	assert_almost_eq(center.y, CITY_CENTER.y, 1.0, "city centred at y=64")
	var area_ratio := float(count) / (PI * CITY_RADIUS * CITY_RADIUS)
	assert_almost_eq(area_ratio, 1.0, 0.03, "the city fills a circle, not a rectangle")


func test_city_is_safe_and_plains_are_not() -> void:
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			var zone := _zone_at(t)
			var type := zone.tile_type(_local(t))
			if _in_circle(t):
				if _city_dist(t) <= CITY_FLOOR_RADIUS:
					assert_eq(type, "town_floor", "%s inside the circle is town floor" % str(t))
					assert_true(_safe(t), "%s inside the circle is safe" % str(t))
				else:
					assert_true(type in ["wall", "gate_post", "town_floor"], "%s is city wall, gate post or gate opening" % str(t))
					if type == "town_floor":
						assert_true(_safe(t), "%s gate opening is safe" % str(t))
			elif type != "wall" and type != "gate" and type != "gate_post":
				assert_eq(type, "grass", "%s outside the city is plains" % str(t))
				assert_false(_safe(t), "%s on the plains is not safe" % str(t))


func test_city_spans_the_central_chunks() -> void:
	for x in range(GRID_W):
		for y in range(GRID_H):
			var expected := "city" if x >= 1 and x <= 4 else "plains"
			assert_eq(world.chunk_kind(world.chunk_at_cell(Vector2i(x, y))), expected, "chunk [%d, %d] kind" % [x, y])


func test_start_entry_and_merchant_are_in_the_city() -> void:
	var entry := _start_entry()
	assert_true(_in_circle(entry), "entry %s inside the city" % str(entry))
	assert_true(_safe(entry), "entry is safe")
	var chunked := ChunkedWorld.load_file(WORLD_PATH, ZONES_DIR)
	assert_eq(chunked.start_chunk, START_CHUNK, "ChunkedWorld starts in the city chunk by default")
	assert_eq(chunked.start_entry(), entry)

	var merchants := 0
	for chunk_id: String in world.chunk_ids():
		var zone: Zone = zones[chunk_id]
		for npc: Dictionary in zone.npcs:
			if str(npc.get("id", "")) != MERCHANT_ID:
				continue
			merchants += 1
			var tile := world.chunk_to_world(chunk_id, _tile(npc["tile"]))
			assert_true(_in_circle(tile), "merchant %s inside the city" % str(tile))
			assert_true(_walkable(tile) and _safe(tile), "merchant stands on safe floor")
			assert_lt((Vector2(tile) - Vector2(entry)).length(), 10.0, "merchant is close to the entry")
	assert_eq(merchants, 1, "exactly one city merchant")


func test_city_keeps_fountain_houses_and_torches() -> void:
	var decor := {}
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			var name := _zone_at(t).decor_at(_local(t))
			if not name.is_empty() and name != "grass_tuft":
				assert_true(_in_circle(t), "%s decor at %s sits inside the city" % [name, str(t)])
				decor[name] = int(decor.get(name, 0)) + 1
	assert_eq(int(decor.get("fountain", 0)), 4, "a 2x2 fountain")
	var house_parts := 0
	for name: String in decor.keys():
		if name.begins_with("house_"):
			house_parts += int(decor[name])
	assert_gt(house_parts, 0, "multi-tile house parts")
	assert_gt(int(decor.get("house_a_door", 0)) + int(decor.get("house_b_door", 0)), 0, "walkable house doors")
	assert_gt(int(decor.get("torch", 0)), 0, "torches")


func test_enemies_spawn_only_on_the_plains() -> void:
	var f := FileAccess.open(ENEMIES_PATH, FileAccess.READ)
	var enemies: Variant = JSON.parse_string(f.get_as_text())
	f.close()
	var total := 0
	for chunk_id: String in world.chunk_ids():
		var zone: Zone = zones[chunk_id]
		for spawn: Dictionary in zone.spawns:
			total += 1
			var tile := world.chunk_to_world(chunk_id, _tile(spawn["tile"]))
			assert_true(_walkable(tile), "spawn %s walkable" % str(tile))
			assert_false(_safe(tile), "spawn %s outside the safe city" % str(tile))
			assert_false(_in_circle(tile), "spawn %s outside the city" % str(tile))
			assert_true((enemies as Dictionary).has(str(spawn["enemy"])), "enemy '%s' is defined" % spawn["enemy"])
	assert_gte(total, 20, "the plains around the city are populated")
	var west_corner: Zone = zones[world.chunk_at_cell(Vector2i(0, 0))]
	assert_gt(west_corner.spawns.size(), 0, "the outer plains chunks have enemies")
