extends GutTest

## JGT-133: the Floor 1 city is a circle of radius 61 tiles centred at (96, 64),
## ringed by a solid 3 tile thick wall with one 8 tile gate on its west side and
## one on its east side (rows 60..67). The plains around the city are only
## reachable through those two gates. Generated by tools/gen_floor1_layout.py.

const ZONES_DIR := "res://data/zones/floor1"
const WORLD_PATH := ZONES_DIR + "/world.json"
const START_CHUNK := "floor1_x2_y1"
const CHUNK := 32
const MAP_W := 288
const MAP_H := 128

const CITY_CENTER := Vector2(96.0, 64.0)
const CITY_RADIUS := 61.0
const CITY_FLOOR_RADIUS := 58.0
const GATE_ROW_MIN := 60
const GATE_ROW_MAX := 67
const GATE_WIDTH := 8

var world: WorldMap = null
var zones: Dictionary = {}  # chunk id -> Zone


func before_all() -> void:
	world = WorldMap.load_file(WORLD_PATH)
	for chunk_id: String in world.chunk_ids():
		var stem := world.zone_stem(chunk_id)
		zones[chunk_id] = Zone.load_files(ZONES_DIR.path_join(stem + ".map"), ZONES_DIR.path_join(stem + ".json"))


func _zone_at(world_tile: Vector2i) -> Zone:
	return zones.get(world.chunk_id_at_tile(world_tile), null)


func _local(world_tile: Vector2i) -> Vector2i:
	return Vector2i(posmod(world_tile.x, CHUNK), posmod(world_tile.y, CHUNK))


func _walkable(world_tile: Vector2i) -> bool:
	if world_tile.x < 0 or world_tile.y < 0 or world_tile.x >= MAP_W or world_tile.y >= MAP_H:
		return false
	var zone := _zone_at(world_tile)
	return zone != null and zone.is_walkable(_local(world_tile))


func _tile_type(world_tile: Vector2i) -> String:
	var zone := _zone_at(world_tile)
	return zone.tile_type(_local(world_tile)) if zone != null else ""


func _city_dist(world_tile: Vector2i) -> float:
	return (Vector2(world_tile) + Vector2(0.5, 0.5) - CITY_CENTER).length()


func _in_circle(world_tile: Vector2i) -> bool:
	return _city_dist(world_tile) <= CITY_RADIUS


func _on_city_wall(world_tile: Vector2i) -> bool:
	var d := _city_dist(world_tile)
	return d > CITY_FLOOR_RADIUS and d <= CITY_RADIUS


func _is_gate_opening(world_tile: Vector2i) -> bool:
	return _on_city_wall(world_tile) and _walkable(world_tile)


func _start_entry() -> Vector2i:
	var zone: Zone = zones[START_CHUNK]
	return world.chunk_to_world(START_CHUNK, zone.entry)


func _reachable(start: Vector2i, blocked: Dictionary = {}) -> Dictionary:
	var seen := {start: true}
	var queue: Array[Vector2i] = [start]
	var head := 0
	while head < queue.size():
		var t := queue[head]
		head += 1
		for step: Vector2i in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
			var n := t + step
			if seen.has(n) or blocked.has(n) or not _walkable(n):
				continue
			seen[n] = true
			queue.append(n)
	return seen


func _gate_openings(side: int) -> Array[Vector2i]:
	## Walkable city wall tiles on one side: -1 west, 1 east.
	var tiles: Array[Vector2i] = []
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if not _is_gate_opening(t):
				continue
			if (side < 0 and t.x < CITY_CENTER.x) or (side > 0 and t.x > CITY_CENTER.x):
				tiles.append(t)
	return tiles


func test_plains_are_reached_only_through_the_two_gates() -> void:
	var entry := _start_entry()
	var seen := _reachable(entry)

	var outside: Array[Vector2i] = []
	for t: Vector2i in seen.keys():
		if not _in_circle(t):
			outside.append(t)
	assert_gt(outside.size(), 0, "the entry reaches the plains through the city gates")

	# Every step from the city to the plains leaves through a gate opening.
	for t: Vector2i in outside:
		for step: Vector2i in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
			var inside := t + step
			if seen.has(inside) and _in_circle(inside):
				assert_true(_is_gate_opening(inside), "the city only opens through its gates, leaked at %s" % str(inside))

	# With both gate rows blocked the city is sealed: nothing outside is reached.
	var blocked := {}
	for y in range(GATE_ROW_MIN, GATE_ROW_MAX + 1):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if _is_gate_opening(t):
				blocked[t] = true
	assert_gt(blocked.size(), 0, "the two gates are walkable openings")
	var trapped := _reachable(entry, blocked)
	for t: Vector2i in trapped.keys():
		assert_true(_in_circle(t), "both gates blocked must seal the city, leaked at %s" % str(t))


func test_the_hub_walks_east_to_every_boss_gate_tile() -> void:
	var seen := _reachable(_start_entry())
	var gate_count := 0
	for transition: Dictionary in world.transitions_of("floor1_x5_y3"):
		var local_tile: Vector2i = transition["from_tile"]
		var gate_tile := world.chunk_to_world("floor1_x5_y3", local_tile)
		assert_true(_walkable(gate_tile), "boss gate tile %s is walkable" % str(gate_tile))
		assert_eq(_tile_type(gate_tile), "gate", "boss gate tile %s uses the gate art" % str(gate_tile))
		assert_true(seen.has(gate_tile), "the player walks from the hub east to boss gate tile %s" % str(gate_tile))
		gate_count += 1
	assert_eq(gate_count, 10, "all ten boss gate tiles are checked")


func test_city_wall_ring_is_solid_and_at_least_three_tiles_thick() -> void:
	for y in range(MAP_H):
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if not _on_city_wall(t) or _is_gate_opening(t):
				continue
			assert_false(_walkable(t), "wall ring tile %s is solid" % str(t))
			assert_true(_tile_type(t) in ["wall", "gate_post"], "wall ring tile %s uses wall or gate post art" % str(t))

	# Away from the gate rows the left and right wall runs at least 3 tiles across.
	for y in range(MAP_H):
		if y >= GATE_ROW_MIN - 8 and y <= GATE_ROW_MAX + 8:
			continue
		var left := 0
		var right := 0
		for x in range(MAP_W):
			var t := Vector2i(x, y)
			if not _on_city_wall(t) or _walkable(t):
				continue
			if x < int(CITY_CENTER.x):
				left += 1
			elif x > int(CITY_CENTER.x):
				right += 1
		if left > 0:
			assert_gte(left, 3, "left wall at row %d is at least 3 tiles thick" % y)
		if right > 0:
			assert_gte(right, 3, "right wall at row %d is at least 3 tiles thick" % y)

	# The top and bottom caps are three tiles deep as well.
	for x in range(int(CITY_CENTER.x) - 1, int(CITY_CENTER.x) + 2):
		var up := 0
		var down := 0
		for y in range(MAP_H):
			var t := Vector2i(x, y)
			if not _on_city_wall(t) or _walkable(t):
				continue
			if y < int(CITY_CENTER.y):
				up += 1
			elif y > int(CITY_CENTER.y):
				down += 1
		assert_gte(up, 3, "top wall at x=%d is at least 3 tiles thick" % x)
		assert_gte(down, 3, "bottom wall at x=%d is at least 3 tiles thick" % x)


func test_both_gates_are_walkable_and_eight_wide() -> void:
	for side: int in [-1, 1]:
		var openings := _gate_openings(side)
		assert_gt(openings.size(), 0, "the city has a%s gate" % (" west" if side < 0 else "n east"))
		var rows := {}
		var columns := {}
		for t: Vector2i in openings:
			var zone := _zone_at(t)
			assert_true(zone.is_safe(_local(t)), "gate tile %s is safe floor" % str(t))
			assert_true(_tile_type(t) in ["town_floor", "road"], "gate tile %s is paved floor" % str(t))
			rows[t.y] = true
			columns[t.x] = true
		assert_eq(rows.size(), GATE_WIDTH, "the gate is %d tiles wide" % GATE_WIDTH)
		for y: int in rows.keys():
			assert_between(y, GATE_ROW_MIN, GATE_ROW_MAX, "gate row %d is on rows 60..67" % y)
		assert_eq(columns.size(), 3, "the gate cuts through the 3 tile wall thickness")


func test_entry_can_walk_out_through_the_west_and_east_gate() -> void:
	var entry := _start_entry()
	var seen := _reachable(entry)
	var west_out := Vector2i(int(CITY_CENTER.x) - int(CITY_RADIUS) - 1, int(CITY_CENTER.y))
	var east_out := Vector2i(int(CITY_CENTER.x) + int(CITY_RADIUS), int(CITY_CENTER.y))
	assert_false(_in_circle(west_out), "west outside tile is on the plains")
	assert_false(_in_circle(east_out), "east outside tile is on the plains")
	assert_true(_walkable(west_out) and _walkable(east_out), "the plains tiles outside both gates are walkable")
	assert_true(seen.has(west_out), "the entry walks out west of the city through the west gate")
	assert_true(seen.has(east_out), "the entry walks out east of the city through the east gate")
	assert_true(_is_gate_opening(west_out + Vector2i.RIGHT), "the west outside tile is reached through the west gate opening")
	assert_true(_is_gate_opening(east_out + Vector2i.LEFT), "the east outside tile is reached through the east gate opening")


func test_no_spawn_within_three_tiles_of_the_city_wall() -> void:
	var total := 0
	for chunk_id: String in world.chunk_ids():
		var zone: Zone = zones[chunk_id]
		for spawn: Dictionary in zone.spawns:
			total += 1
			var arr: Array = spawn["tile"]
			var tile := world.chunk_to_world(chunk_id, Vector2i(int(arr[0]), int(arr[1])))
			assert_gte(_city_dist(tile), CITY_RADIUS + 3.0, "spawn %s stays 3 tiles off the city wall" % str(tile))
	assert_gt(total, 0, "the plains have enemy spawns")
